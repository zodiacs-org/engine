{
  "name": "@zodiacs/electional-workbench",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.7.0 <23"
  },
  "scripts": {
    "build": "npm run build:engine && tsc --project tsconfig.build.json",
    "check:isolation": "node scripts/check-isolation.mjs",
    "schema": "npm run build && node scripts/export-schema.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test": "npm run build:engine && vitest run --config vitest.config.ts",
    "build:engine": "node scripts/build-engine.mjs",
    "cli": "node bin/electional.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astronomy-engine": "2.1.19",
    "yaml": "2.9.1"
  }
}
