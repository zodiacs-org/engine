      "expected": [{"startMs":-5,"endMs":5}]
    },
    {
      "id": "one-millisecond-gap",
      "derivation": "t=0 is absent; neither side may fill that missing millisecond.",
      "input": [{"startMs":1,"endMs":2},{"startMs":-1,"endMs":0}],
      "expected": [{"startMs":-1,"endMs":0},{"startMs":1,"endMs":2}]
    },
    {
      "id": "empty-set",
      "derivation": "Empty input and empty spans contain no members.",
      "input": [{"startMs":-1,"endMs":-1},{"startMs":0,"endMs":0}],
      "expected": []
    }
  ],
  "binary": [
    {
      "id": "partial-overlap",
