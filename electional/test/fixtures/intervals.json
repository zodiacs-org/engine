  "normalization": [
    {
      "id": "unsorted-overlap-adjacency-and-empty",
      "derivation": "[2,6), [5,8), and [8,12) cover every t from 2 through 11. [4,4) contains nothing. [-3,-1) stays separate.",
      "input": [{"startMs":8,"endMs":12},{"startMs":5,"endMs":8},{"startMs":-3,"endMs":-1},{"startMs":2,"endMs":6},{"startMs":4,"endMs":4}],
      "expected": [{"startMs":-3,"endMs":-1},{"startMs":2,"endMs":12}]
    },
    {
      "id": "nested-and-duplicate",
      "derivation": "Both inner spans and the duplicate add no member to [-5,5).",
