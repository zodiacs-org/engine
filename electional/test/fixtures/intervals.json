{
  "reference": {
    "arbiter": "Hand-derived half-open interval logic",
    "method": "Each integer millisecond t belongs exactly when startMs <= t < endMs. The results below were written by applying AND, OR, and AND NOT to membership, independently of the interval implementation.",
    "clock": "Synthetic integer epoch-millisecond labels on one shared clock; no astronomical instants",
    "license": "MIT",
    "scope": "Set arithmetic only; no astronomical accuracy claim"
