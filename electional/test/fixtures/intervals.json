      "left": [{"startMs":8,"endMs":12},{"startMs":0,"endMs":2},{"startMs":4,"endMs":6}],
      "right": [{"startMs":1,"endMs":10}],
      "union": [{"startMs":0,"endMs":12}],
      "intersection": [{"startMs":1,"endMs":2},{"startMs":4,"endMs":6},{"startMs":8,"endMs":10}],
      "difference": [{"startMs":0,"endMs":1},{"startMs":10,"endMs":12}]
    },
    {
      "id": "several-cuts-with-external-and-empty-spans",
      "derivation": "External [20,22) and empty [7,7) remove nothing. Two interior cuts leave the three intervening stretches; [-2,0) merely touches the left edge.",
      "left": [{"startMs":0,"endMs":10}],
      "right": [{"startMs":20,"endMs":22},{"startMs":6,"endMs":8},{"startMs":7,"endMs":7},{"startMs":2,"endMs":4},{"startMs":-2,"endMs":0}],
      "union": [{"startMs":-2,"endMs":10},{"startMs":20,"endMs":22}],
      "intersection": [{"startMs":2,"endMs":4},{"startMs":6,"endMs":8}],
      "difference": [{"startMs":0,"endMs":2},{"startMs":4,"endMs":6},{"startMs":8,"endMs":10}]
    },
    {
      "id": "entirely-excluded",
      "derivation": "Every member of [-1,1) belongs to [-3,3); left AND NOT right is empty.",
      "left": [{"startMs":-1,"endMs":1}],
      "right": [{"startMs":-3,"endMs":3}],
      "union": [{"startMs":-3,"endMs":3}],
