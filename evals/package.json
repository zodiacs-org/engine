{
  "name": "@zodiacs/interpretation-evals",
  "private": true,
  "type": "module",
  "description": "Offline interpretation dataset tooling and chart-reading evaluations.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.checks.mjs",
    "validate:entry": "node bin/validate-entry.mjs",
    "validate:dataset": "node bin/validate-dataset.mjs",
    "validate:seed": "node bin/validate-dataset.mjs --seed data/seed.json",
    "validate:reading": "node bin/validate-reading.mjs",
    "generate": "node bin/generate-interpretations.mjs",
    "evaluate": "node bin/evaluate-reading.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "astronomy-engine": "2.1.19",
    "esbuild": "0.28.2"
  }
}
