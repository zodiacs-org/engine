{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zodiacs:evals:generation-manifest:1.0.0",
  "title": "Successful interpretation generation manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "generator", "prompt", "sources", "plan", "backend", "limits", "calls", "datasetDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "implementationDigest", "node"],
      "properties": {
        "version": { "const": "interpretation-generator-v1" },
        "implementationDigest": { "$ref": "#/$defs/digest" },
        "node": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "const": "meaning-v1" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sources": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "entryIds", "digest"],
      "properties": {
        "id": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/id" },
        "entryIds": {
          "type": "array", "minItems": 1, "maxItems": 255, "uniqueItems": true,
          "items": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/id" }
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "plan": { "$ref": "urn:zodiacs:evals:generation-plan:1.0.0" },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "model", "version", "mode"],
      "properties": {
        "id": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/id" },
        "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 160 },
        "mode": { "enum": ["offline", "network"] }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxInputBytes", "maxOutputBytes", "timeoutMs", "maxCalls"],
      "properties": {
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "maxCalls": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "calls": {
      "type": "array", "minItems": 1, "maxItems": 255,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["entryId", "requestDigest", "responseDigest", "finishReason"],
        "properties": {
          "entryId": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/id" },
          "requestDigest": { "$ref": "#/$defs/digest" },
          "responseDigest": { "$ref": "#/$defs/digest" },
          "finishReason": { "const": "stop" }
        }
      }
    },
    "datasetDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}(?![\\s\\S])" }
  }
}
