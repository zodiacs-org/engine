{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:zodiacs:evals:synthetic-chart:1.0.0",
  "title": "Synthetic chart evaluation case",
  "description": "Invented input only. The synthetic marker records a caller assertion, not proof of origin. Calendar validity is additionally checked by the engine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "synthetic", "birth"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/id" },
    "synthetic": { "const": true },
    "birth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["utc"],
      "dependentRequired": { "latitude": ["longitude"], "longitude": ["latitude"] },
      "properties": {
        "utc": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
        },
        "timeScale": { "enum": ["utc", "ut1", "tt"] },
        "timeKnown": { "type": "boolean" },
        "latitude": { "type": "number", "exclusiveMinimum": -90, "exclusiveMaximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "houseSystem": { "$ref": "urn:zodiacs:evals:meaning-entry:1.0.0#/$defs/house/properties/houseSystem" },
        "deltaT": { "type": "number", "minimum": -10000000000, "maximum": 10000000000 }
      }
    }
  }
}
