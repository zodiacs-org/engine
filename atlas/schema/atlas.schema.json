{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zodiacs-org/engine/atlas/schema/atlas.schema.json",
  "title": "Historical time atlas data files",
  "description": "One schema for every data file under atlas/data. Each file names its kind in its top-level `kind` field. The generated files under atlas/tzdb are not covered here; the checks regenerate them and compare.",
  "oneOf": [
    { "$ref": "#/$defs/manifestFile" },
    { "$ref": "#/$defs/citationsFile" },
    { "$ref": "#/$defs/leadsFile" },
    { "$ref": "#/$defs/placesFile" },
    { "$ref": "#/$defs/rulesFile" },
    { "$ref": "#/$defs/explanationsFile" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "localTime": {
      "description": "A wall-clock reading, YYYY-MM-DDTHH:MM:SS with optional milliseconds. Which clock it is read on is given by the boundary's `reckoning`.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "manifestFile": {
      "type": "object",
      "required": ["kind", "name", "version", "released", "license", "coverage", "files"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-manifest" },
        "name": { "$ref": "#/$defs/text" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "released": { "$ref": "#/$defs/date" },
        "license": { "const": "CC-BY-4.0" },
        "coverage": {
          "type": "object",
          "required": ["start", "end", "countries", "note"],
          "properties": {
            "start": { "$ref": "#/$defs/localTime" },
            "end": { "$ref": "#/$defs/localTime" },
            "countries": { "type": "array", "minItems": 1, "items": { "enum": ["FR", "US"] } },
            "note": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        },
        "files": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9/._-]+\\.json$" }
        },
        "longitudeSource": {
          "type": "object",
          "required": ["dataset", "url", "retrieved", "sha256", "license", "licenseUrl", "changes"],
          "properties": {
            "dataset": { "$ref": "#/$defs/text" },
            "url": { "type": "string", "pattern": "^https://" },
            "retrieved": { "$ref": "#/$defs/date" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "license": { "$ref": "#/$defs/text" },
            "licenseUrl": { "type": "string", "pattern": "^https://" },
            "attribution": { "$ref": "#/$defs/text" },
            "changes": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "citationsFile": {
      "type": "object",
      "required": ["kind", "citations"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-citations" },
        "description": { "$ref": "#/$defs/text" },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/citation" } }
      },
      "additionalProperties": false
    },
    "citation": {
      "description": "One passage of one primary source, as fetched and read.",
      "type": "object",
      "required": ["id", "type", "title", "date", "issuer", "url", "retrieved", "locator", "language", "excerpt", "excerptBasis", "checks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": [
            "law",
            "decree",
            "ministerial-decision",
            "parliamentary-debate",
            "municipal-notice",
            "municipal-record",
            "official-notice",
            "newspaper-report",
            "railway-notice",
            "railway-timetable"
          ]
        },
        "title": { "$ref": "#/$defs/text" },
        "date": { "$ref": "#/$defs/date" },
        "issuer": { "$ref": "#/$defs/text" },
        "publication": { "$ref": "#/$defs/text" },
        "url": { "type": "string", "pattern": "^https://" },
        "retrieved": { "$ref": "#/$defs/date" },
        "locator": { "$ref": "#/$defs/text" },
        "language": { "enum": ["fr", "de", "en"] },
        "excerpt": {
          "description": "A verbatim passage of at most 40 words (words are counted as runs of text between spaces; an omission is marked [...]).",
          "$ref": "#/$defs/text"
        },
        "excerptBasis": {
          "description": "How the excerpt was taken. page-image: transcribed from the page image; ocr: copied from the archive's OCR text, including the snippets its search service returns; ocr-checked: the archive's OCR, corrected against the page image.",
          "enum": ["page-image", "ocr", "ocr-checked"]
        },
        "checks": {
          "description": "Each time the excerpt was compared with the source after it was taken, and how.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["method", "date", "result"],
            "properties": {
              "method": {
                "description": "page-image: against the page image; ocr: against the archive's OCR text of the page; search-service: against the snippets of the page's OCR that the archive's in-document search returns (Gallica's ContentSearch, used where Gallica's page and image servers refused automated requests).",
                "enum": ["page-image", "ocr", "search-service"]
              },
              "date": { "$ref": "#/$defs/date" },
              "result": {
                "description": "matches: every word of the excerpt was found, allowing for OCR errors; partial: some words could not be confirmed by this method (the note says which and why).",
                "enum": ["matches", "partial"]
              },
              "note": { "$ref": "#/$defs/text" }
            },
            "additionalProperties": false
          }
        },
        "gloss": { "$ref": "#/$defs/text" },
        "note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "leadsFile": {
      "type": "object",
      "required": ["kind", "leads"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-leads" },
        "description": { "$ref": "#/$defs/text" },
        "leads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "title", "note"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "enum": ["tzdb-comment", "secondary-work"] },
              "title": { "$ref": "#/$defs/text" },
              "url": { "type": "string", "pattern": "^https://" },
              "note": { "$ref": "#/$defs/text" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "placesFile": {
      "type": "object",
      "required": ["kind", "places"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-places" },
        "description": { "$ref": "#/$defs/text" },
        "places": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/place" } }
      },
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "required": ["id", "name", "country", "admin1", "jurisdiction", "latitude", "longitude", "geonamesId", "tzdbZone"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "country": { "enum": ["FR", "US"] },
        "admin1": { "$ref": "#/$defs/text" },
        "jurisdiction": { "$ref": "#/$defs/id" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "geonamesId": { "type": "integer", "minimum": 1 },
        "tzdbZone": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z_+-]+)+$" },
        "compareZones": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_]+(/[A-Za-z_+-]+)+$" } },
        "note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "rulesFile": {
      "type": "object",
      "required": ["kind", "jurisdictions", "rules"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-rules" },
        "description": { "$ref": "#/$defs/text" },
        "jurisdictions": { "type": "array", "items": { "$ref": "#/$defs/jurisdiction" } },
        "rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } }
      },
      "additionalProperties": false
    },
    "jurisdiction": {
      "description": "Places whose clocks followed the same sequence of rules over the whole coverage window. A rule may appear in several jurisdictions.",
      "type": "object",
      "required": ["id", "name", "country", "description", "timeline"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "country": { "enum": ["FR", "US"] },
        "description": { "$ref": "#/$defs/text" },
        "timeline": {
          "type": "object",
          "required": ["civil"],
          "properties": {
            "civil": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
            "railway": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
          },
          "additionalProperties": false
        },
        "readByLongitude": {
          "description": "Present only where the rules hold for places the atlas does not list: which départements (INSEE codes) may be read by longitude, the longitude limits in each area, and the départements refused with the reason.",
          "type": "object",
          "required": ["areas", "excluded", "note"],
          "properties": {
            "areas": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["name", "departments", "minLongitude", "maxLongitude"],
                "properties": {
                  "name": { "$ref": "#/$defs/text" },
                  "departments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/department" } },
                  "minLongitude": { "type": "number", "minimum": -180, "maximum": 180 },
                  "maxLongitude": { "type": "number", "minimum": -180, "maximum": 180 }
                },
                "additionalProperties": false
              }
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["departments", "reason"],
                "properties": {
                  "departments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/department" } },
                  "reason": { "$ref": "#/$defs/text" }
                },
                "additionalProperties": false
              }
            },
            "note": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "department": {
      "description": "A French département's INSEE code: 01-95 (20 does not exist) or 2A, 2B for Corsica.",
      "type": "string",
      "pattern": "^(0[1-9]|1[0-9]|2[1-9AB]|[3-8][0-9]|9[0-5])$"
    },
    "boundary": {
      "description": "The instant a rule starts or ends: the moment the clock named by `reckoning` reads `local`. For a start, `before` is the clock of the rule in force just before the instant and `after` the rule's own; for an end, `before` is the rule's own clock and `after` the next rule's. `coverage` marks the edge of the atlas window rather than a historical change.",
      "type": "object",
      "required": ["local", "reckoning", "kind", "precision"],
      "properties": {
        "local": { "$ref": "#/$defs/localTime" },
        "reckoning": { "enum": ["before", "after", "utc"] },
        "kind": { "enum": ["event", "coverage"] },
        "precision": {
          "description": "How exactly the sources fix this instant: to the second, minute or hour, to the day, to a few days, or to some weeks.",
          "enum": ["second", "minute", "hour", "day", "days", "weeks"]
        },
        "window": {
          "description": "For an instant known only within limits: the earliest and latest local readings, on the same clock as `local`.",
          "type": "object",
          "required": ["earliest", "latest"],
          "properties": {
            "earliest": { "$ref": "#/$defs/localTime" },
            "latest": { "$ref": "#/$defs/localTime" }
          },
          "additionalProperties": false
        },
        "citations": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "offset": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "seconds"],
          "properties": {
            "type": { "const": "fixed" },
            "seconds": { "type": "number", "minimum": -43200, "maximum": 50400 }
          },
          "additionalProperties": false
        },
        {
          "description": "The place's own mean solar time: 240 seconds per degree of longitude east, from the place's longitude.",
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "const": "local-mean-time" }
          },
          "additionalProperties": false
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "version", "title", "scope", "clock", "start", "end", "offset", "isDst", "uncertainty", "citations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" },
        "clock": {
          "description": "civil: public and legal time as the town's clocks showed it; railway: the time kept inside stations and in timetables where it differed.",
          "enum": ["civil", "railway"]
        },
        "start": { "$ref": "#/$defs/boundary" },
        "end": { "$ref": "#/$defs/boundary" },
        "offset": { "$ref": "#/$defs/offset" },
        "isDst": { "type": "boolean" },
        "abbreviation": { "type": "string", "pattern": "^[A-Za-z0-9+-]{2,8}$" },
        "uncertainty": {
          "type": "object",
          "required": ["flag", "reason"],
          "properties": {
            "flag": { "enum": ["documented", "inferred", "uncertain"] },
            "reason": { "$ref": "#/$defs/text" }
          },
          "additionalProperties": false
        },
        "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "changes": {
          "description": "What changed in each version after the first.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "date", "summary"],
            "properties": {
              "version": { "type": "integer", "minimum": 2 },
              "date": { "$ref": "#/$defs/date" },
              "summary": { "$ref": "#/$defs/text" }
            },
            "additionalProperties": false
          }
        },
        "note": { "$ref": "#/$defs/text" }
      },
      "additionalProperties": false
    },
    "explanationsFile": {
      "type": "object",
      "required": ["kind", "tzdb", "explanations"],
      "properties": {
        "$schema": { "type": "string" },
        "kind": { "const": "atlas-tzdb-explanations" },
        "tzdb": { "type": "string", "pattern": "^[0-9]{4}[a-z]$" },
        "description": { "$ref": "#/$defs/text" },
        "explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "category", "match", "explanation", "citations"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "category": {
                "enum": [
                  "place-mean-time",
                  "local-adoption",
                  "annexed-territory",
                  "transition-instant",
                  "transition-date",
                  "summer-time-observance",
                  "reference-offset"
                ]
              },
              "match": {
                "description": "A difference is explained by this entry when its place, zone and atlas rule are listed and the atlas's and tzdb's offsets (seconds east) are among those listed. Every difference must match exactly one entry, and every value listed must occur in a difference the entry explains.",
                "type": "object",
                "required": ["places", "zones", "rules", "atlasOffsets", "tzdbOffsets"],
                "properties": {
                  "places": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
                  "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
                  "zones": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "atlasOffsets": { "type": "array", "minItems": 1, "items": { "type": "number" } },
                  "tzdbOffsets": { "type": "array", "minItems": 1, "items": { "type": "number" } }
                },
                "additionalProperties": false
              },
              "explanation": { "$ref": "#/$defs/text" },
              "tzdbReport": {
                "description": "What the atlas would report to the tz project about this difference, with the sources: an apparent error in tzdb, or a difference between the instant a law set and tzdb's entry, saying which. Nothing has been sent.",
                "$ref": "#/$defs/text"
              },
              "citations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
