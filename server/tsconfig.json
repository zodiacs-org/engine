{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "astronomy-engine": ["./node_modules/astronomy-engine/astronomy.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.vitest.ts", "vitest.config.ts"]
}
