{
  "name": "@zodiacs/engine-http-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hosted HTTP adapter for the engine in this source checkout.",
  "engines": { "node": ">=22.22.2 <23" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node build/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && vitest run --config vitest.config.ts",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
