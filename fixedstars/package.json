{
  "name": "@zodiacs/fixedstars-worktree",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT AND CC-BY-SA-4.0",
  "description": "Isolated fixed-star library and CLI development on engine source",
  "bin": {
    "fixedstars": "./bin/fixedstars.mjs"
  },
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "fixedstars": "node ./bin/fixedstars.mjs",
    "test": "vitest run --config vitest.config.mjs",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:check": "node scripts/build-catalog.mjs --check",
    "catalog:fetch": "node scripts/build-catalog.mjs --fetch",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "check:isolation": "node scripts/verify-isolation.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
