  "build": {
    "makeEquivalent": "make PACKRATDATA=backzone PACKRATLIST=zone.tab tzdata.zi; zic -d DIR tzdata.zi",
    "ziguard": "awk -v DATAFORM=main -v PACKRATDATA=backzone -v PACKRATLIST=zone.tab -f ziguard.awk africa antarctica asia australasia europe northamerica southamerica etcetera factory backward backzone >main.zi",
    "zishrink": "LC_ALL=C awk -v dataform=main -v deps='ziguard.awk africa antarctica asia australasia  europe northamerica southamerica etcetera factory backward backzone zone.tab zishrink.awk' -v redo=posix_right -v version=2025c -f zishrink.awk main.zi >tzdata.zi",
    "zic": "zic -d DIR tzdata.zi",
    "zicOptions": "defaults of zic 2025c: -b slim, no -L (no leap seconds), no -r",
    "zicInputs": [
      "africa",
      "antarctica",
      "asia",
      "australasia",
      "europe",
      "northamerica",
      "southamerica",
      "etcetera",
      "factory",
      "backward",
      "backzone"
    ],
    "packratList": "zone.tab",
    "zicAndZdump": "built from the tzcode tarball extracted over the tzdata tarball (one tree): make zic zdump"
  },
  "compiledTree": {
    "zic": "zic (tzcode) 2025c",
    "files": 598,
    "sha256": "98ba2bd3eb549fced32814888318d478c96eb65d5fa5b482ee1d89ebb298bcc5",
