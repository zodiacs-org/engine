## the source of <scratch>/bin/figures.mjs
// Figures of the time entry's formal run that the checks assert but do not
// print, read from the files the checks read: api/time.api.md (T1); the time
// entry's and the root's static graphs from the build's module list, as
// scripts/module-resolution-smoke.mjs reads them with scripts/root-isolation.mjs
// (T2, T13); OPT_IN_SOURCE (T13); the ./time budget's comment and sizes.json
// against package:contents' figure (T9); and the scratch consumer the tools
// read. It runs no check and changes no file.
//
//   node figures.mjs <checkout> <extracted package> <package:contents log>
import { lstatSync, readFileSync, readdirSync, readlinkSync } from "node:fs";
import { join } from "node:path";
import { pathToFileURL } from "node:url";

const [checkout, pkg, contentsLog] = process.argv.slice(2);
const { OPT_IN_SOURCE, readModuleList, staticGraph } = await import(pathToFileURL(join(checkout, "scripts/root-isolation.mjs")).href);
const say = (line = "") => console.log(line);

say("## T1: api/time.api.md, its exported block's heading and the names declared there (src/time.test.ts's pattern)");
const report = readFileSync(join(checkout, "api/time.api.md"), "utf8");
const block = /## Exported \((\d+)\)\n\n```ts\n([\s\S]*?)\n```/u.exec(report);
const declared = [...block[2].matchAll(/^(?:declare const|declare function|interface|type) ([A-Za-z_]\w*)/gmu)].map((m) => m[1]).sort();
say(`heading: ## Exported (${block[1]}); names found: ${declared.length}`);
say(declared.join(", "));
say(`a block "## Referenced, not exported here": ${report.includes("## Referenced, not exported here") ? "present" : "absent"}`);

say();
say("## T2: the time entry's static graph from the build's module list (dist/metafile-esm.json and dist/metafile-lite.json), read both ways");
const metafile = readModuleList(new URL("dist/", pathToFileURL(`${checkout}/`)));
const readBuilt = (path) => readFileSync(join(checkout, path), "utf8");
const graph = staticGraph({ metafile, read: readBuilt, entryOutput: "dist/time.js", entrySource: "src/time.ts" });
const bytes = (path) => Buffer.byteLength(readBuilt(path));
say(`outputs (${graph.outputs.length} files, ${graph.outputs.reduce((sum, path) => sum + bytes(path), 0)} bytes):`);
for (const path of graph.outputs) {
  const specifiers = [...readBuilt(path).matchAll(/\b(?:from\s*|import\s*)["']([^"']+)["']/gu)].map((m) => m[1]);
  say(`  ${path} ${bytes(path)} bytes; imports: ${specifiers.length ? specifiers.join(" ") : "nothing"}`);
}
say(`sources (${graph.sources.length}): ${graph.sources.join(" ")}`);
say(`held (${graph.held.length}): ${graph.held.join(" ")}`);
say(`marked (${graph.marked.length}): ${graph.marked.join(" ")}`);
const all = [...new Set([...graph.held, ...graph.marked])].sort();
const importsAstronomy = all.filter((source) => (metafile.inputs[source]?.imports ?? []).some((edge) => edge.path === "astronomy-engine"));
const optIn = all.filter((source) => OPT_IN_SOURCE.test(source));
say(`held or marked and importing astronomy-engine: ${importsAstronomy.length ? importsAstronomy.join(" ") : "none"}`);
say(`held or marked and matched by OPT_IN_SOURCE: ${optIn.length ? optIn.join(" ") : "none"}`);
say(`src/ephemeris.ts held or marked: ${all.includes("src/ephemeris.ts")}; src/api.ts held or marked: ${all.includes("src/api.ts")}`);

say();
say("## T13: OPT_IN_SOURCE (scripts/root-isolation.mjs) on the time entry's files and the root's time scale, and the root's static graph");
say(`OPT_IN_SOURCE = ${OPT_IN_SOURCE}`);
for (const path of ["src/time.ts", "src/time-bands.ts", "src/time-scale.ts", "src/time-scale-data.ts"]) say(`  ${path}: ${OPT_IN_SOURCE.test(path) ? "matched (opt-in)" : "not matched (the root's)"}`);
const root = staticGraph({ metafile, read: readBuilt, entryOutput: "dist/index.js", entrySource: "src/index.ts" });
const rootAll = new Set([...root.sources, ...root.held, ...root.marked]);
for (const path of ["src/time-scale.ts", "src/time-scale-data.ts", "src/time.ts", "src/time-bands.ts"]) say(`  in the root's graph: ${path} ${rootAll.has(path)}`);
say(`  the root's graph: ${root.sources.length} source modules, ${root.marked.length} marked in ${root.outputs.length} files`);

say();
say("## T9: the ./time budget as written (scripts/verify-package-contents.mjs), the cut's sizes.json, and this run's package:contents");
const contents = readFileSync(join(checkout, "scripts/verify-package-contents.mjs"), "utf8").split("\n");
const at = contents.findIndex((line) => line.includes('"./time": '));
say(contents.slice(at - 6, at + 1).join("\n"));
const sizes = JSON.parse(readFileSync(join(checkout, "docs/evidence/1.1.0-rc.2-20261102/sizes.json"), "utf8"));
say(`sizes.json, 1.1.0-rc.2, ./time: ${JSON.stringify(sizes["1.1.0-rc.2"].entries["./time"])}`);
say(`sizes.json, 1.1.0-rc.1, ./time: ${JSON.stringify(sizes["1.1.0-rc.1"].entries?.["./time"] ?? null)}`);
const measured = /\.\/time (\d+) of (\d+)/u.exec(readFileSync(contentsLog, "utf8"));
say(`this run's package:contents: ./time ${measured[1]} of ${measured[2]}; the graph above sums to ${graph.outputs.reduce((sum, path) => sum + bytes(path), 0)}; sizes.json's ${sizes["1.1.0-rc.2"].entries["./time"].bytes}`);

say();
say("## the scratch consumer the tools read (<scratch>/consumer/node_modules)");
const modules = join(pkg, "..", "..");
for (const name of readdirSync(modules).sort()) {
  const path = join(modules, name);
  if (lstatSync(path).isSymbolicLink()) say(`  ${name} -> ${readlinkSync(path)}`);
  else for (const inner of readdirSync(path).sort()) say(`  ${name}/${inner} (a directory: the extracted package, ${readdirSync(join(path, inner, "dist")).length} files in dist/)`);
}
# exit 0, finished 2026-11-04 12:41:02 +0700
