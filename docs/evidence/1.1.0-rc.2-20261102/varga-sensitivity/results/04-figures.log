## the script, <scratch>/bin/figures.mjs
/*
 * Not a check and not a rerun: it runs no engine and no reference, and
 * changes no verdict. It reads this run's outputs in results/ and
 * results-erfa/ (after the hand shortening of their paths) and prints the
 * figures RESULTS.md cites that the tools' summaries do not print as such:
 * sums, counts by corpus and point, and listings. Run from the unit folder.
 */
import { existsSync, readFileSync } from "node:fs";

if (process.argv[2]) process.chdir(process.argv[2]);
const json = (path) => JSON.parse(readFileSync(path, "utf8"));
const lines = (path) => readFileSync(path, "utf8").trim().split("\n").map((text) => JSON.parse(text));
const show = (title, value) => console.log(`## ${title}\n${typeof value === "string" ? value : JSON.stringify(value, null, 1)}`);

show("results/steps.tsv", readFileSync("results/steps.tsv", "utf8").trim());

// G-V1, G-V2 (a) and the named tests: vitest's report.
const tests = json("results/tests.json");
show("results/tests.json: totals", {
  success: tests.success, suites: tests.numTotalTestSuites, suitesFailed: tests.numFailedTestSuites,
  tests: tests.numTotalTests, passed: tests.numPassedTests, failed: tests.numFailedTests, pending: tests.numPendingTests, todo: tests.numTodoTests
});
show("results/tests.json: by file (passed, failed, other)", tests.testResults.map((file) => {
  const by = (status) => file.assertionResults.filter((test) => test.status === status).length;
  return `${file.name.replace(/^.*?\/src\//u, "src/")}: ${by("passed")} passed, ${by("failed")} failed, ${file.assertionResults.length - by("passed") - by("failed")} other; ${file.status}`;
}).join("\n"));
const all = tests.testResults.flatMap((file) => file.assertionResults.map((test) => ({ file: file.name.replace(/^.*?\/src\//u, "src/"), ...test })));
const gv1 = all.filter((test) => /places D\d+(cyclic)? exactly/u.test(test.fullName));
show("G-V1: the varga tests of src/vedic/boundaries.test.ts ('places D.. exactly')", `${gv1.length} tests, ${gv1.filter((test) => test.status === "passed").length} passed: ${gv1.map((test) => test.title).join("; ")}`);
const gv2a = all.filter((test) => test.fullName.endsWith("the change boundaries are the fixture's change rows"));
show("G-V2 (a): the per-key tests 'the change boundaries are the fixture's change rows'", `${gv2a.length} tests, ${gv2a.filter((test) => test.status === "passed").length} passed`);
show("tests not passed", all.filter((test) => test.status !== "passed").map((test) => `${test.file}: ${test.fullName} (${test.status})`).join("\n") || "none");

show("results/f1-check.json", (({ check, sha256, total, keepsInDegrees }) => ({ check, sha256, total, keepsInDegrees }))(json("results/f1-check.json")));
show("results/inputs-sha256.txt", readFileSync("results/inputs-sha256.txt", "utf8").trim());
show("results/boundaries-sha256.txt", readFileSync("results/boundaries-sha256.txt", "utf8").trim());

const testControls = json("results/test-controls.json");
show("results/test-controls.json", { node: testControls.node, platform: testControls.platform, allFailedAsTheyMust: testControls.allFailedAsTheyMust });
for (const control of testControls.controls) {
  console.log(`- ${control.name} | ${control.file} | ${control.test} | must fail: ${control.mustFail} | ${control.failedTests} of ${control.of} failed | ${control.failedAsItMust ? "failed as it must" : "DID NOT FAIL AS IT MUST"}\n    ${control.failed.join("\n    ")}`);
}

// G-V3: the run and the checker.
const run = json("results/run.json");
show("results/run.json", { engine: run.engine, node: run.node, platform: run.platform, limit: run.limit, corpora: run.corpora.map(({ corpus, file, sha256, seed, calls }) => ({ corpus, file, sha256, seed, calls })), calls: run.calls, threw: run.threw, callMs: run.callMs, wallMinutes: run.wallMinutes });
const results = lines("results/results.jsonl");
const rows = results.flatMap((line) => (line.result?.rows ?? []).map((row) => ({ corpus: line.corpus, id: line.id, ...row })));
const byCorpus = {};
for (const line of results) {
  const entry = (byCorpus[line.corpus] ??= { calls: 0, rows: 0, refused: 0, changes: 0, nullSides: 0, maxEvaluations: 0 });
  entry.calls += 1;
  for (const row of line.result?.rows ?? []) {
    entry.rows += 1;
    if (row.refusal) entry.refused += 1;
    for (const side of ["previous", "next"]) row[side] ? (entry.changes += 1) : (entry.nullSides += 1);
  }
  const total = Object.values(line.result?.evaluations ?? {}).reduce((a, b) => a + b, 0);
  entry.maxEvaluations = Math.max(entry.maxEvaluations, total);
}
show("results/results.jsonl by corpus: calls, rows, refused rows, changes, null sides (refused rows' sides included), the largest evaluations of a call", byCorpus);
show("refusals in results.jsonl, by reason", rows.filter((row) => row.refusal).reduce((out, row) => ({ ...out, [row.refusal.reason]: (out[row.refusal.reason] ?? 0) + 1 }), {}));
const seams = [...json("seams.json").cases.map((entry) => ["F3", entry]), ...json("seams-f3b.json").cases.map((entry) => ["F3b", entry])];
show("F3 and F3b: each case's expected change (seams.json, seams-f3b.json) and the row's change in results.jsonl", seams.map(([corpus, entry]) => {
  const line = results.find((each) => each.corpus === corpus && each.id === entry.id);
  const want = entry.expected;
  if (!want) return `${corpus} ${entry.id}: expected null (not planted); call ${line?.error ? "threw" : "returned"}, ${line?.result?.rows.length} rows, refused ${line?.result?.rows.filter((row) => row.refusal).length}`;
  const row = line.result.rows.find((each) => each.point === line.options.points[0] && each.varga === want.varga && each.scheme === want.scheme);
  const got = row?.[want.side];
  return `${corpus} ${entry.id}: ${line.options.points[0]} ${want.varga} ${want.side}: expected ${want.at} ${want.boundary} ${want.from}->${want.to}; got ${got ? `${got.at} ${got.boundary} ${got.from}->${got.to}` : "null"}`;
}).join("\n"));

const check = json("results/check.json");
show("results/check.json", { results: check.results, node: check.node, platform: check.platform, stepScale: check.stepScale, trial: check.trial, calls: check.calls, verdict: check.verdict, failuresByCheck: check.failuresByCheck, failures: check.failures.slice(0, 50), checkerMinutes: check.checkerMinutes });
const reported = check.reported;
const perPoint = {};
for (const [key, count] of Object.entries(reported.changesByPointAndKey)) {
  const point = key.replace(/ D\d+(cyclic)?$/u, "");
  perPoint[point] = (perPoint[point] ?? 0) + count;
}
show("G-V3 reported: changes by point (summed over the 18 keys), all calls", perPoint);
show("G-V3 reported: changes in all", Object.values(perPoint).reduce((a, b) => a + b, 0));
show("G-V3 reported: changes by point and key", reported.changesByPointAndKey);
show("G-V3 reported: null sides, evaluations per call and per point, call times, public calls, M5 samples", { nullSides: reported.nullSides, evaluationsPerCall: reported.evaluationsPerCall, evaluationsPerPoint: reported.evaluationsPerPoint, callMs: reported.callMs, publicCalls: reported.publicCalls, m5Samples: reported.m5Samples });
show("G-V3 reported: the disclosure", reported.disclosure);

const controls = json("results/controls.json");
show("results/controls.json", { results: controls.results, stepScale: controls.stepScale, dryRun: controls.dryRun, allFailed: controls.allFailed });
for (const [name, control] of Object.entries(controls.controls)) {
  console.log(`- ${name} | must fail: ${control.mustFail} | ${control.failed ? "failed as it must" : "DID NOT FAIL"} | verdict ${control.verdict} | ${JSON.stringify(control.failuresByCheck)}${control.id !== undefined ? ` | F2 birth ${control.id}: ${control.changed} (${control.file})` : ""}\n    first failures: ${JSON.stringify((control.failures ?? []).slice(0, 3))}`);
}

// Section 7 and G-V5.
const bounds = json("results/derived-bounds.json");
show("results/derived-bounds.json", Object.fromEntries(Object.entries(bounds.rates).map(([name, entry]) => [name, { a: entry.a, largest: entry.largestLatitudeWithPositiveLowerBound, rows: entry.rows.map((row) => `${row.latitude}: R_lo ${row.R_lo}, R_hi ${row.R_hi}, longest bracket ${row.longestBracketMs} ms${row.note ? `, ${row.note}` : ""}`) }])));
show("results/derived-bounds-control.txt", readFileSync("results/derived-bounds-control.txt", "utf8").trim());
show("results/derived-bounds-control-verdict.txt", readFileSync("results/derived-bounds-control-verdict.txt", "utf8").trim());
const g5 = json("results/time-per-arcsecond.json");
show("results/time-per-arcsecond.json", { engine: g5.engine, node: g5.node, platform: g5.platform, sampled: g5.sampled, rows: g5.rows.map(({ body, samples, medianSpeed, tenthPercentileSpeed, smallestSpeed, atMedian, atTenthPercentile }) => ({ body, samples, medianSpeed, tenthPercentileSpeed, smallestSpeed, atMedian, atTenthPercentile })) });
for (const name of ["time-per-arcsecond-write.txt", "time-per-arcsecond-control-copy.txt", "time-per-arcsecond-control.txt"]) show(`results/${name}`, readFileSync(`results/${name}`, "utf8").trim());

// G-V4.
const runErfa = json("results-erfa/run.json");
show("results-erfa/run.json", { engine: runErfa.engine, node: runErfa.node, platform: runErfa.platform, corpora: runErfa.corpora.map(({ corpus, file, sha256, seed, calls }) => ({ corpus, file, sha256, seed, calls })), calls: runErfa.calls, threw: runErfa.threw, callMs: runErfa.callMs, wallMinutes: runErfa.wallMinutes });
const erfaLines = lines("results-erfa/results.jsonl");
show("results-erfa/results.jsonl: rows, refused rows, changes, null sides", erfaLines.reduce((out, line) => {
  for (const row of line.result?.rows ?? []) {
    out.rows += 1;
    if (row.refusal) out.refused += 1;
    for (const side of ["previous", "next"]) row[side] ? (out.changes += 1) : (out.nullSides += 1);
  }
  return out;
}, { calls: erfaLines.length, rows: 0, refused: 0, changes: 0, nullSides: 0 }));
for (const name of ["compare.json", "control-c4a.json", "control-c4b.json"]) {
  if (!existsSync(`results-erfa/${name}`)) {
    show(`results-erfa/${name}`, "absent: not written (the run was stopped before it)");
    continue;
  }
  const report = json(`results-erfa/${name}`);
  show(`results-erfa/${name}`, { erfa: report.erfa, python: report.python, control: report.control, births: report.births, judged: report.judged, notJudged: report.notJudged, mismatches: report.mismatches, compared: report.compared, comparedFailed: report.comparedFailed, bands: report.bands, verdict: report.verdict, failures: report.failures.length, firstFailures: report.failures.slice(0, 5) });
}
