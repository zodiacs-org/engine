. "$(dirname "$0")/env.sh"
cd "$CHECKOUT" || exit 2
run() { printf '## %s\n' "$*"; "$@"; }
printf '## L11: the six lite files in required, and the ./lite budget with its comment (scripts/verify-package-contents.mjs)\n'
grep -n -E '^  "dist/lite[.-]' scripts/verify-package-contents.mjs
sed -n '196,204p' scripts/verify-package-contents.mjs | nl -ba -v 196 -w4 -s': '
printf '## L10: OPT_IN_SOURCE (scripts/root-isolation.mjs)\n'
sed -n '40,41p' scripts/root-isolation.mjs | nl -ba -v 40 -w4 -s': '
printf '## L1: dist/lite.js as built, and the bytes of the entry'"'"'s five files and its declarations\n'
run cat dist/lite.js
run wc -c dist/lite.js dist/lite-declinations.js dist/lite-sect.js dist/lite-composite.js dist/lite-dignities.js dist/lite.d.ts
printf '## L5: the control build (<scratch>/l5-control/dist, from broken-builds.mjs --l5-control) against this build\n'
for f in lite.js lite-sect.js lite-composite.js lite-dignities.js; do
