## appended after the run, for the record: the script that printed the above, <scratch>/figures.py
    """Figures for RESULTS.md, printed from the files the checks read (not a second
    run of any check): E10's inputs, E5's chunk and its importers in the unpacked
    rc.2 pack, and the old item 8 wording in the time entry's guide.
        python3 -I figures.py <checkout> <unpacked rc.2 package>
    """
    import json
    import os
    import re
    import sys
    
    checkout, package = sys.argv[1], sys.argv[2]
    
    
    def text(path):
        with open(path, encoding="utf-8") as f:
            return f.read()
    
    
    summary = json.loads(text(os.path.join(checkout, "conformance/results/summary.json")))
    run = [r for r in summary["runs"] if r["adapter"]["name"] == "zodiacs-engine"][0]
    kind = run["summary"]["byKind"]["angles.vertex-east-point"]
    print("## E10: conformance/results/summary.json, the zodiacs-engine run, angles.vertex-east-point")
    print("vectors", kind["count"], "; Vertex max", repr(kind["residuals"]["vertex"]["max"]),
          "; East Point max", repr(kind["residuals"]["east_point"]["max"]))
    readme = re.sub(r"\s+", " ", text(os.path.join(checkout, "README.md")))
    m = re.search(r"On the conformance suite's ten L2 vectors for them, [^.]*?they are within ([\d.]+)″ and ([\d.]+)″", readme)
    if m:
        print("README.md states", m.group(1) + "″", "and", m.group(2) + "″")
    else:
        print("README.md states no figures in that sentence")
    results_md = text(os.path.join(checkout, "conformance/RESULTS.md"))
    row = [line for line in results_md.splitlines() if "angles.vertex-east-point" in line]
    print("conformance/RESULTS.md rows naming angles.vertex-east-point:", len(row))
    for line in row:
        print("   ", line.strip())
    vectors = [v for v in json.loads(text(os.path.join(checkout, "conformance/vectors/L2-houses-angles.json")))["vectors"]
               if v["kind"] == "angles.vertex-east-point"]
    lats = [v["input"]["lat"] for v in vectors]
    print("L2 vectors of that kind:", len(vectors), "; latitudes", min(lats), "to", max(lats))
    
    print("## E5: the Gregorian adoption table in the unpacked rc.2 pack")
    dist = os.path.join(package, "dist")
    js = sorted(n for n in os.listdir(dist) if n.endswith(".js"))
    holders = [n for n in js if "var GREGORIAN_ADOPTION =" in text(os.path.join(dist, n))]
    print("holders:", holders)
    importers = [n for n in js if holders and "./" + holders[0] in text(os.path.join(dist, n))]
    print("files that import it:", importers)
    
    print("## item 8: the old wording in the time entry's guide and declarations")
    old = "the engine's model when absent"
    for rel in ("docs/time.md",):
        print(rel, "(not packed):", "present" if old in re.sub(r"\s+", " ", text(os.path.join(checkout, rel))) else "absent")
    decl = re.sub(r"\s+", " ", "\n".join(re.sub(r"^\s*\*\s?", "", l) for l in text(os.path.join(dist, "time.d.ts")).split("\n")))
    print("dist/time.d.ts (packed, also in E1's scan):", "present" if old in decl else "absent")
