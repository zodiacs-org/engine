## this harness, e6-control.mjs:
    // E6's control (F-89 PREREGISTRATION.md, section 5, as amended on 2026-11-03), run at the formal
    // run in scratch: the bases that src/calc-bounds.test.ts's case "name ERFA, not Horizons, as the
    // basis of the mean points' bounds" asserts, for the Mean Node, the Mean South Node and Black Moon
    // Lilith in the true ecliptic of date and the ICRS equatorial frame at the test's instant, checked on
    // the calc entry of the package in the directory given (its package.json and dist/, with
    // astronomy-engine resolvable from it). On the rc.2 pack they must hold, or this harness is wrong;
    // on the carried 1.1.0-rc.1 archive they must fail, since the mean points' basis there is the
    // Horizons text (dist/calc.js of that archive).
    //   node e6-control.mjs <package directory>
    import { readFileSync } from "node:fs";
    import { join, resolve } from "node:path";
    import { pathToFileURL } from "node:url";
    
    const root = resolve(process.argv[2]);
    const manifest = JSON.parse(readFileSync(join(root, "package.json"), "utf8"));
    const { calc } = await import(pathToFileURL(join(root, manifest.exports["./calc"].import)).href);
    // The two constants as the committed test spells them (src/calc-bounds.test.ts).
    const MEAN_POINTS_BASIS =
      "largest difference from the same definition evaluated with ERFA's fundamental arguments (faom03, faf03, fal03) " +
      "and nut06a's nutation in longitude, over 32 instants from JD 2379457.498125 to 2520522.646618 (TT), " +
      "in all eight frames: a check of the implementation, not of an ephemeris; docs/evidence/calc-api/rc16";
    const MEAN_POINTS_SPEED_BASIS =
      "largest difference from the rate of the same definition evaluated with ERFA's fundamental arguments " +
      "(faom03, faf03, fal03) and nut06a's nutation in longitude, taken over 0.0001 day either side, over 32 instants " +
      "from JD 2379457.498125 to 2520522.646618 (TT), in the true ecliptic of date only: a check of the " +
      "implementation, not of an ephemeris; docs/evidence/calc-api/rc16";
    const time = "2011-02-03T04:05:06Z";
    console.log(`package ${manifest.name}@${manifest.version}`);
    let checked = 0;
    let failures = 0;
    for (const body of ["Mean Node", "Mean South Node", "Black Moon Lilith"]) {
      for (const frame of ["ecliptic-true-of-date", "equatorial-icrs"]) {
        const result = calc({ body, time, frame });
        if (result.status !== "ok") throw new Error(`${body}, ${frame}: ${result.status} ${result.reason}`);
        for (const [kind, want] of [["position", MEAN_POINTS_BASIS], ["speed", MEAN_POINTS_SPEED_BASIS]]) {
          const basis = result.bounds[kind]?.basis;
          checked += 1;
          if (basis !== want) failures += 1;
          console.log(`${basis === want ? "holds" : "FAILS"}  ${body}, ${frame}, ${kind} bound's basis: ${JSON.stringify(basis)}`);
        }
      }
    }
    const node = calc({ body: "North Node", time });
    console.log(`(the North Node's position bound, which keeps MEASURED_BASIS: ${JSON.stringify(node.status === "ok" ? node.bounds.position.basis : node.status)})`);
    console.log(`${failures} of ${checked} assertions fail`);
    process.exit(failures ? 1 : 0);
