# sh analyses.sh generators, Node v22.22.2, npm 10.9.7, 2026-09-29

## zone histories, the system's zic
$ env TZDATA_TARBALL=<tzdata2025c.tar.gz> node scripts/build-tz-shards.mjs --check
tz-shards: src/tzdb/ matches tzdb 2025c (597 names)
exit 0

## zone histories, zic 2025c first on PATH
$ env TZDATA_TARBALL=<tzdata2025c.tar.gz> PATH=<zic 2025c directory>:$PATH node scripts/build-tz-shards.mjs --check
tz-shards: src/tzdb/ matches tzdb 2025c (597 names)
exit 0

## time scales from the committed sources
$ node scripts/build-time-scales.mjs --check
time-scales: src/time-scale-data.ts matches scripts/time-scale-sources/
exit 0

## time scales, and the finals2000A.all rows against the whole file
$ env IERS_FINALS=<finals2000A.all> node scripts/build-time-scales.mjs --check
time-scales: src/time-scale-data.ts matches scripts/time-scale-sources/, and its rows match finals2000A.all
exit 0

