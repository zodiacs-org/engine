diff --git a/scripts/build-core.mjs b/scripts/build-core.mjs
new file mode 100644
index 0000000..1fe30c8
--- /dev/null
+++ b/scripts/build-core.mjs
@@ -0,0 +1,59 @@
+// The build of @zodiacs/engine/core (prototype), which `npm run build` runs
+// after tsup and scripts/build-lite.mjs.
+//
+// The core entry exports what the root exports and computes on
+// astronomy-engine, without the shipped DE440 pack. tsup builds the root with
+// code splitting, and the root's ephemeris module imports the pack, so the
+// core entry takes no part in that build: esbuild, the version tsup runs,
+// bundles src/core.ts on its own into dist/core.js, with
+// src/core/ephemeris-shipped.ts in place of src/ephemeris-shipped.ts (the
+// module that names the default source and opens the pack), and
+// astronomy-engine left as an import of the package's dependency. It writes
+// dist/core.js (unminified, as the lite parts are), dist/core.d.ts (the
+// root's declarations, by re-export) and dist/metafile-core.json (not
+// packed), and checks that no module of the pack is in the bundle.
+import assert from "node:assert/strict";
+import { readFileSync, writeFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+import { build } from "esbuild";
+
+const ROOT = fileURLToPath(new URL("..", import.meta.url));
+const at = (path) => new URL(`../${path}`, import.meta.url);
+const target = JSON.parse(readFileSync(at("tsconfig.base.json"), "utf8")).compilerOptions.target.toLowerCase();
+
+let swapped = 0;
+const result = await build({
+  absWorkingDir: ROOT,
+  entryPoints: { core: "src/core.ts" },
+  bundle: true,
+  splitting: false,
+  format: "esm",
+  platform: "neutral",
+  target,
+  tsconfig: "tsconfig.build.json",
+  external: ["astronomy-engine"],
+  metafile: true,
+  minify: false,
+  outdir: "dist",
+  write: true,
+  logLevel: "warning",
+  plugins: [{
+    name: "core-ephemeris",
+    setup(builder) {
+      builder.onResolve({ filter: /^\.\/ephemeris-shipped\.js$/ }, () => {
+        swapped += 1;
+        return { path: fileURLToPath(at("src/core/ephemeris-shipped.ts")) };
+      });
+    }
+  }]
+});
+assert.equal(swapped, 1, "src/ephemeris.ts must import ./ephemeris-shipped.js once, and nothing else may");
+const inputs = Object.keys(result.metafile.inputs);
+for (const banned of ["src/de440-pack.ts", "src/de440/pack-data.ts", "src/ephemeris-shipped.ts"]) {
+  assert(!inputs.includes(banned), `dist/core.js must not hold ${banned}`);
+}
+assert.deepEqual(result.metafile.outputs["dist/core.js"].imports.map((entry) => entry.path), ["astronomy-engine"],
+  "dist/core.js may import astronomy-engine and nothing else");
+writeFileSync(at("dist/core.d.ts"), 'export * from "./index.js";\n');
+writeFileSync(at("dist/metafile-core.json"), JSON.stringify(result.metafile, null, 2) + "\n");
+console.log(`core: dist/core.js ${Buffer.byteLength(readFileSync(at("dist/core.js")))} bytes`);
