{
  "name": "@zodiacs-local/mansions",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "mansions": "scripts/mansions.mjs"
  },
  "scripts": {
    "mansions": "node scripts/mansions.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "check:examples": "node scripts/check-examples.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check": "npm run typecheck && npm test && npm run check:examples && npm run check:isolation"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
