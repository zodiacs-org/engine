{
  "name": "@zodiacs/geocode-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Offline place lookup and IANA civil-time resolution, developed separately from the engine package.",
  "license": "MIT AND CC-BY-4.0",
  "engines": {
    "node": ">=22.7.0 <23"
  },
  "bin": {
    "geocode": "bin/geocode.mjs"
  },
  "scripts": {
    "geocode": "node bin/geocode.mjs",
    "index:build": "tsc -p tsconfig.tools.json && node .cache/tools/scripts/build-index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "scope:check": "node scripts/check-scope.mjs",
    "check": "npm run typecheck && npm test && npm run scope:check"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "tsx": "4.23.15"
  }
}
