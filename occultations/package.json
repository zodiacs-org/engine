{
  "name": "@zodiacs/occultations-workbench",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Offline occultation and appulse workbench over the adjacent engine source",
  "engines": { "node": ">=22.7.0 <23" },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:astrometry": "python3 scripts/astrometry-reference.py && vitest run --config vitest.astrometry.config.ts",
    "build": "node scripts/build.mjs",
    "catalogue:check": "node scripts/catalogue.mjs",
    "catalogue:verify-source": "node scripts/catalogue.mjs --download",
    "check:scope": "node scripts/check-scope.mjs",
    "check": "npm run typecheck && npm test && npm run catalogue:check && npm run build && npm run check:scope"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.27.7",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
