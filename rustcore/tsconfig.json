{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "astronomy-engine": ["./node_modules/astronomy-engine/astronomy.d.ts"]
    },
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["ts/**/*.ts", "tests/**/*.ts", "benchmarks/**/*.ts", "vitest.config.ts"]
}
