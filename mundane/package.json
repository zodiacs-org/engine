{
  "name": "@zodiacs/mundane-workbench",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.7.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "check": "npm run typecheck && npm test",
    "check:examples": "node scripts/check-examples.mjs",
    "check:scope": "node scripts/check-scope.mjs && node scripts/check-package-isolation.mjs",
    "build": "node scripts/build-cli.mjs",
    "mundane": "node bin/mundane.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "esbuild": "0.21.5",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "bin": {
    "mundane": "bin/mundane.mjs"
  }
}
