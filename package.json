{
  "name": "@zodiacs/engine",
  "version": "2.1.0",
  "description": "Browser-first astrology calculations used by Zodiacs.org: tropical charts; one calculation API with bounds and receipts in ./calc; birth-time windows in ./window; returns, relationship charts, the void-of-course Moon, patterns and dignities in ./techniques; house positions and cusp speeds in ./houses; rise, set, transit and planetary hours in ./sky; Hellenistic timing techniques and planetary returns in ./timing; the time basis and the frame of date, without the ephemeris, in ./time; declination parallels, sect, composite midpoints and dignities, without the ephemeris, in ./lite; positions from astronomy-engine by default, from JPL's DE440 after one call to useDe440() from ./de440/pack, which ships the pack, or from a caller's pack in ./de440; Chiron, Ceres, Pallas, Juno and Vesta from tables fitted to NASA JPL Horizons in ./minor-bodies; ./core, the root under its 2.x name; and the sidereal zodiac and Jyotish techniques in ./vedic.",
  "license": "MIT AND CC-BY-4.0",
  "keywords": [
    "astrology",
    "ephemeris",
    "natal-chart",
    "synastry",
    "transits",
    "typescript",
    "zodiac"
  ],
  "homepage": "https://github.com/zodiacs-org/engine#readme",
  "bugs": {
    "url": "https://github.com/zodiacs-org/engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zodiacs-org/engine.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./calc": {
      "types": "./dist/calc.d.ts",
      "default": "./dist/calc.js"
    },
    "./conventions": {
      "types": "./dist/conventions.d.ts",
      "default": "./dist/conventions.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./crossings": {
      "types": "./dist/crossings.d.ts",
      "default": "./dist/crossings.js"
    },
    "./deltat": {
      "types": "./dist/deltat.d.ts",
      "default": "./dist/deltat.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "default": "./dist/geo.js"
    },
    "./houses": {
      "types": "./dist/houses-extra.d.ts",
      "default": "./dist/houses-extra.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./internal/math": {
      "types": "./dist/internal-math.d.ts",
      "default": "./dist/internal-math.js"
    },
    "./lite": {
      "types": "./dist/lite.d.ts",
      "default": "./dist/lite.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "default": "./dist/receipt.js"
    },
    "./sky": {
      "types": "./dist/sky.d.ts",
      "default": "./dist/sky.js"
    },
    "./techniques": {
      "types": "./dist/techniques.d.ts",
      "default": "./dist/techniques.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./de440": {
      "types": "./dist/de440.d.ts",
      "default": "./dist/de440.js"
    },
    "./de440/pack": {
      "types": "./dist/de440-pack.d.ts",
      "default": "./dist/de440-pack.js"
    },
    "./minor-bodies": {
      "types": "./dist/minor-bodies.d.ts",
      "default": "./dist/minor-bodies.js"
    },
    "./timing": {
      "types": "./dist/timing.d.ts",
      "default": "./dist/timing.js"
    },
    "./vedic": {
      "types": "./dist/vedic.d.ts",
      "default": "./dist/vedic.js"
    },
    "./window": {
      "types": "./dist/window.d.ts",
      "default": "./dist/window.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSING.md",
    "NOTICE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/crossings.ts src/deltat.ts src/geo.ts src/receipt.ts src/techniques.ts src/timing.ts src/vedic.ts src/internal.ts src/internal-math.ts src/calc.ts src/window.ts src/houses-extra.ts src/sky.ts src/conventions.ts src/time.ts src/de440.ts src/de440-pack.ts src/core.ts src/minor-bodies.ts --format esm --dts --clean --splitting --metafile --tsconfig tsconfig.build.json && node scripts/build-chunk-imports.mjs && node scripts/build-lite.mjs",
    "docs": "typedoc --options typedoc.json",
    "exports:smoke": "node scripts/module-resolution-smoke.mjs && node scripts/verify-dist-purity.mjs",
    "consumer:smoke": "node scripts/verify-packed-consumer.mjs",
    "package:contents": "node scripts/verify-package-contents.mjs",
    "archive:binding": "node scripts/verify-archive-binding.mjs",
    "api:report": "node scripts/api-report.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "ratchet:check": "node scripts/ratchet.mjs --check --tests .cache/vitest-report.json",
    "dashes:check": "node scripts/verify-no-dashes.mjs",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile=.cache/vitest-report.json",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "0.27.7",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
