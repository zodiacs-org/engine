{
  "name": "@zodiacs/engine",
  "version": "0.1.1-rc.15",
  "description": "Browser-first astrology calculations used by Zodiacs.org: tropical charts, Hellenistic timing techniques in ./timing, and the sidereal zodiac and Jyotish techniques in ./vedic.",
  "license": "MIT AND CC-BY-4.0",
  "keywords": [
    "astrology",
    "ephemeris",
    "natal-chart",
    "synastry",
    "transits",
    "typescript",
    "zodiac"
  ],
  "homepage": "https://github.com/zodiacs-org/engine#readme",
  "bugs": {
    "url": "https://github.com/zodiacs-org/engine/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zodiacs-org/engine.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./calc": {
      "types": "./dist/calc.d.ts",
      "import": "./dist/calc.js"
    },
    "./crossings": {
      "types": "./dist/crossings.d.ts",
      "import": "./dist/crossings.js"
    },
    "./deltat": {
      "types": "./dist/deltat.d.ts",
      "import": "./dist/deltat.js"
    },
    "./geo": {
      "types": "./dist/geo.d.ts",
      "import": "./dist/geo.js"
    },
    "./houses": {
      "types": "./dist/houses-extra.d.ts",
      "import": "./dist/houses-extra.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./internal/math": {
      "types": "./dist/internal-math.d.ts",
      "import": "./dist/internal-math.js"
    },
    "./receipt": {
      "types": "./dist/receipt.d.ts",
      "import": "./dist/receipt.js"
    },
    "./techniques": {
      "types": "./dist/techniques.d.ts",
      "import": "./dist/techniques.js"
    },
    "./timing": {
      "types": "./dist/timing.d.ts",
      "import": "./dist/timing.js"
    },
    "./vedic": {
      "types": "./dist/vedic.d.ts",
      "import": "./dist/vedic.js"
    },
    "./window": {
      "types": "./dist/window.d.ts",
      "import": "./dist/window.js"
    }
  },
  "files": [
    "dist/*.d.ts",
    "dist/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSING.md",
    "NOTICE"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/crossings.ts src/deltat.ts src/geo.ts src/receipt.ts src/techniques.ts src/timing.ts src/vedic.ts src/internal.ts src/internal-math.ts src/calc.ts src/window.ts src/houses-extra.ts --format esm --dts --clean --splitting --metafile --tsconfig tsconfig.build.json",
    "docs": "typedoc --options typedoc.json",
    "exports:smoke": "node scripts/module-resolution-smoke.mjs",
    "consumer:smoke": "node scripts/verify-packed-consumer.mjs",
    "package:contents": "node scripts/verify-package-contents.mjs",
    "archive:binding": "node scripts/verify-archive-binding.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
